{
    "name": "openframe/plugin-market-sdk",
    "description": "Ed25519 package signing, verification and revocation SDK for Laravel plugin markets.",
    "keywords": [
        "laravel",
        "plugin",
        "market",
        "signature",
        "ed25519",
        "sodium"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "ext-zip": "*",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/process": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Openframe\\PluginMarketSdk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Openframe\\PluginMarketSdk\\PluginMarketSdkServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
